<Window x:Class="Dictionary.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Dictionary.Converters"
        Title="Advanced Dictionary System Pro" Height="650" Width="1000"
        Background="#F0F2F5" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <local:TruncateTextConverter x:Key="TruncateConverter"/>

        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#ECF0F1"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="5,2"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="20,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#34495E"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="1" Color="#D0D0D0"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#2C3E50">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="10,30,10,20">
                    <TextBlock Text="📘 DICTIONARY" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Data Structures Lab" Foreground="#95A5A6" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="10">
                    <Button Content="🔍 Tra cứu từ điển" Style="{StaticResource MenuButtonStyle}" Click="NavTraCuu_Click"/>
                    <Button Content="⚙️ Quản lý dữ liệu" Style="{StaticResource MenuButtonStyle}" Click="NavQuanLy_Click"/>
                    <Button Content="🕒 Lịch sử tra cứu" Style="{StaticResource MenuButtonStyle}" Click="NavLichSu_Click"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="15,0,15,30">
                    <TextBlock Text="Cấu trúc dữ liệu đang dùng:" Foreground="#BDC3C7" FontSize="12" Margin="5,0,0,5"/>
                    <ComboBox x:Name="cbStorageEngine" Height="35" SelectedIndex="0" Background="#34495E" BorderThickness="0" Foreground="Black">
                        <ComboBoxItem Content="B+ Tree"/>
                        <ComboBoxItem Content="Binary Search Tree (BST)"/>
                        <ComboBoxItem Content="Hash Table (Bảng băm)"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="25">

            <Grid x:Name="GridTraCuu" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Search Mode Selection -->
                <Border Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource CardStyle}" Margin="0,0,0,15">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                        <RadioButton x:Name="rbPrefixSearch" Content="🔤 Tìm kiếm tiền tố (Gõ &amp; Enter)" 
                                     IsChecked="True" Margin="0,0,40,0" FontSize="12" Foreground="#2C3E50"
                                     Checked="RbSearchMode_Changed" VerticalAlignment="Center"/>
                        <RadioButton x:Name="rbExactSearch" Content="🎯 Tìm chính xác (Gõ &amp; Enter)" 
                                     Margin="0,0,0,0" FontSize="12" Foreground="#2C3E50"
                                     Checked="RbSearchMode_Changed" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Search Box -->
                <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource CardStyle}" Padding="10" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <DockPanel Grid.Column="0">
                            <TextBlock Text="🔍" VerticalAlignment="Center" Margin="5,0,10,0" FontSize="16"/>
                            <TextBox x:Name="txtSearch" Height="40" VerticalContentAlignment="Center" BorderThickness="0" 
                                     FontSize="14" Tag="Nhập từ vựng và nhấn Enter..." 
                                     KeyDown="TxtSearch_KeyDown"/>
                        </DockPanel>

                        <!-- Search Time Display -->
                        <TextBlock Grid.Column="1" x:Name="lblSearchTime" Text="⏱️ 0ms" 
                                   VerticalAlignment="Center" Margin="15,0,5,0" FontSize="10" 
                                   Foreground="#E74C3C" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </Grid>
                </Border>

                <!-- Prefix Search Results (Left Panel) -->
                <Border x:Name="borderPrefixResults" Grid.Row="2" Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,15,0">
                    <StackPanel>
                        <TextBlock Text="📝 Danh sách từ gần giống:" FontSize="13" FontWeight="Bold" 
                                   Foreground="#2C3E50" Margin="0,0,0,10"/>
                        <ListBox x:Name="lstSuggestions" BorderThickness="0" SelectionChanged="LstSuggestions_SelectionChanged" 
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled" MaxHeight="500">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="5,8">
                                        <TextBlock Text="{Binding Word}" FontWeight="SemiBold" FontSize="14" Foreground="#2980B9"/>
                                        <TextBlock Text="{Binding Preview}" FontSize="11" Foreground="#7F8C8D" TextTrimming="CharacterEllipsis" MaxWidth="250" MaxHeight="30"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <!-- Exact Search Result & Details (Right Panel) -->
                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource CardStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="pnlWordDetails">
                            <TextBlock x:Name="lblWord" Text="Từ vựng" FontSize="32" FontWeight="Bold" Foreground="#2980B9"/>

                            <Grid Margin="0,15,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                
                            </Grid>

                            <Separator Background="#ECF0F1" Margin="0,10"/>

                            <TextBlock Text="" FontSize="18" FontWeight="Bold" Margin="0,10,0,10"/>
                            <ItemsControl x:Name="icMeanings">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F8F9FA" Margin="0,0,0,8" Padding="12" CornerRadius="5">
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="14" LineHeight="20"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <Grid x:Name="GridQuanLy" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Hệ thống Quản lý Dữ liệu" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                    <WrapPanel HorizontalAlignment="Left">
                        <Button Content="📥 Nhập từ File" Width="140" Height="40" Margin="0,0,10,0" 
                                Background="#27AE60" Foreground="White" Click="BtnImport_Click" BorderThickness="0"/>
                        <Button Content="🔥 Xóa tất cả dữ liệu" Width="160" Height="40" 
                                Background="#E74C3C" Foreground="White" BorderThickness="0" Click="BtnClearAll_Click"/>
                    </WrapPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                    <DataGrid x:Name="dgDictionary" AutoGenerateColumns="True" BorderThickness="0" Background="White"/>
                </Border>
            </Grid>

            <Grid x:Name="GridLichSu" Visibility="Collapsed">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Lịch sử tra cứu" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>
                    <Border Style="{StaticResource CardStyle}">
                        <ListView x:Name="lvHistory" BorderThickness="0">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Từ vựng" Width="150" DisplayMemberBinding="{Binding Word}"/>
                                    <GridViewColumn Header="Loại tìm kiếm" Width="100" DisplayMemberBinding="{Binding SearchType}"/>
                                    <GridViewColumn Header="Thời gian tra cứu" Width="150" DisplayMemberBinding="{Binding Time, StringFormat=HH:mm:ss}"/>
                                    <GridViewColumn Header="B+Tree (ms)" Width="90" DisplayMemberBinding="{Binding BPlusTreeTimeMs}"/>
                                    <GridViewColumn Header="BST (ms)" Width="90" DisplayMemberBinding="{Binding BSTTimeMs}"/>
                                    <GridViewColumn Header="Hash Table (ms)" Width="90" DisplayMemberBinding="{Binding HashTableTimeMs}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>
                </DockPanel>
            </Grid>

        </Grid>
    </Grid>
</Window>