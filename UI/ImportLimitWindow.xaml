<Window x:Class="Dictionary.UI.ImportLimitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nhập số lượng từ" Height="250" Width="450"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F0F2F5">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Giới hạn số lượng từ cần nhập" 
                   FontSize="18" FontWeight="Bold" Foreground="#2C3E50"/>

        <TextBlock Grid.Row="2" Text="Nhập số lượng từ (0 = không giới hạn):" 
                   FontSize="13" Foreground="#34495E"/>

        <Border Grid.Row="4" BorderThickness="1" BorderBrush="#BDC3C7" CornerRadius="5" Background="White">
            <TextBox x:Name="txtLimit" Height="40" 
                     FontSize="16" Padding="12" BorderThickness="0"
                     Background="White" Foreground="Black" VerticalContentAlignment="Center"/>
        </Border>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Hủy" Width="110" Height="45" Margin="0,0,15,0"
                    Background="#95A5A6" Foreground="White" BorderThickness="0" Click="BtnCancel_Click" FontSize="13" FontWeight="SemiBold"/>
            <Button Content="Nhập" Width="110" Height="45"
                    Background="#27AE60" Foreground="White" BorderThickness="0" Click="BtnOK_Click" FontSize="13" FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>
