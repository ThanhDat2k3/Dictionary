<Window x:Class="Dictionary.UI.AddWordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thêm từ vựng mới" Height="300" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F0F2F5" Foreground="#2C3E50">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="➕ Thêm từ vựng mới" FontSize="18" FontWeight="Bold" 
                   Foreground="#2980B9" Margin="0,0,0,20"/>

        <!-- Word Input -->
        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <TextBlock Text="Từ vựng:" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,5"/>
            <TextBox x:Name="txtWord" Height="35" Padding="10" FontSize="14" 
                     Background="White" BorderThickness="1" BorderBrush="#BDC3C7"
                     VerticalContentAlignment="Center"/>
        </StackPanel>

        <!-- Definition Input -->
        <StackPanel Grid.Row="2" Margin="0,0,0,15">
            <TextBlock Text="Định nghĩa:" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,5"/>
            <TextBox x:Name="txtDefinition" Height="100" Padding="10" FontSize="12" 
                     Background="White" BorderThickness="1" BorderBrush="#BDC3C7"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     AcceptsReturn="True"/>
        </StackPanel>

        <!-- Spacer -->
        <Grid Grid.Row="3"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="✅ OK" Width="100" Height="40" Margin="0,0,10,0" 
                    Background="#27AE60" Foreground="White" Click="BtnOK_Click" 
                    FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
            <Button Content="❌ Hủy" Width="100" Height="40" 
                    Background="#E74C3C" Foreground="White" Click="BtnCancel_Click" 
                    FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
